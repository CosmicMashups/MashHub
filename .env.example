# Supabase (replace with your project values)
VITE_SUPABASE_URL=https://YOUR-PROJECT-ID.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY

# Public site URL for auth (signup confirmation, magic link redirect).
# Local dev: use http://localhost:5173 (or your Vite port). Must match Supabase redirect allow-list.
# Vercel: https://your-app.vercel.app or your custom domain (no subpath; Vite base is / on Vercel).
# GitHub Pages: https://<owner>.github.io/MashHub (with VITE_BASE_PATH=/MashHub/ in that workflow).
# Do NOT use localhost in production builds — or confirmation emails can contain localhost links.
# Omit in CI to rely on runtime origin; the app also ignores localhost env on non-local hosts.
VITE_SITE_URL=http://localhost:5173
NEXT_PUBLIC_SITE_URL=http://localhost:5173

# Optional: override Vite asset base (default / on Vercel, /MashHub/ otherwise).
# VITE_BASE_PATH=/

# Backend/scripts only - NEVER expose in frontend bundle
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVICE_ROLE_KEY
